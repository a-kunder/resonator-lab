{
  "map_version": 1,
  "name": "resonator-lab",
  "application_version": "1.4.0",
  "repository": "https://github.com/a-kunder/resonator-lab",
  "language": "Python",
  "python_requires": ">=3.9",
  "status": {
    "power_batches": "implemented; physical VNA validation pending",
    "log_thermometry": "implemented; actual lab log validation pending",
    "physical_temperature_control": "disabled; owner-mediated adapter pending",
    "q_fitting": "not implemented",
    "power_dependent_ifbw": "implemented; power-keyed per resonator; physical readback validation pending",
    "input_attenuation": "editable room/cold fields with nominal estimates; Line D preset provided"
  },
  "commands": {
    "install": "python -m pip install -e .",
    "test": "python -m unittest discover -s tests -v",
    "check_map": "python tools/check_project_map.py",
    "simulate": "python -m resonator_lab --simulate --config examples/base_batch_original.json --output data",
    "base_gui": "python launch_power_gui.py"
  },
  "entry_points": [
    {
      "path": "launch_power_gui.py",
      "purpose": "Base power desktop GUI and optional read-only LSCI logs"
    },
    {
      "path": "resonator_lab/__main__.py",
      "purpose": "CLI and general GUI"
    },
    {
      "path": "setup_windows.bat",
      "purpose": "Windows environment setup and tests"
    }
  ],
  "modules": [
    {
      "path": "resonator_lab/model.py",
      "purpose": "Configuration and Trace contracts"
    },
    {
      "path": "resonator_lab/instruments.py",
      "purpose": "Siglent and simulated VNA"
    },
    {
      "path": "resonator_lab/experiment.py",
      "purpose": "Batch orchestration and cleanup"
    },
    {
      "path": "resonator_lab/storage.py",
      "purpose": "Schema, save/load and manifest"
    },
    {
      "path": "resonator_lab/gui.py",
      "purpose": "Tk interface and event queue"
    },
    {
      "path": "resonator_lab/log_thermometry.py",
      "purpose": "Read-only LSCI log parser"
    },
    {
      "path": "resonator_lab/devices.py",
      "purpose": "Device factories and ownership guard"
    },
    {
      "path": "resonator_lab/thermometry.py",
      "purpose": "Temperature settings and interfaces"
    },
    {
      "path": "resonator_lab/temperature_control.py",
      "purpose": "Simulated control and historical native prototype"
    }
  ],
  "documentation": [
    {
      "path": "README.md",
      "purpose": "User entry point"
    },
    {
      "path": "AGENTS.md",
      "purpose": "AI contributor instructions and commit policy"
    },
    {
      "path": "CONTRIBUTING.md",
      "purpose": "Development and contribution workflow"
    },
    {
      "path": "docs/ARCHITECTURE.md",
      "purpose": "Modules, lifecycle and current status"
    },
    {
      "path": "docs/DATA_FORMAT.md",
      "purpose": "Configuration, units and raw data contracts"
    },
    {
      "path": "WINDOWS_SETUP.md",
      "purpose": "Windows setup and driver checks"
    },
    {
      "path": "BATCH_SWEEPS.md",
      "purpose": "Resonator batching and temperature step planner"
    },
    {
      "path": "TEMPERATURE_LOGS.md",
      "purpose": "Log setup, freshness and timestamps"
    },
    {
      "path": "VALIDATION.md",
      "purpose": "Validation evidence and limitations"
    },
    {
      "path": "CHANGELOG.md",
      "purpose": "Version history"
    },
    {
      "path": "docs/CI.md",
      "purpose": "Optional CI workflow template and activation"
    },
    {
      "path": "docs/POWER_IFBW_AND_ATTENUATION.md",
      "purpose": "Power-dependent bandwidths, attenuation and Line D record"
    }
  ],
  "data": {
    "schema_current": "1.2",
    "schemas_readable": [
      "1.0",
      "1.1",
      "1.2"
    ],
    "npz_arrays": {
      "frequency_hz": {
        "dtype": "float64",
        "shape": "N",
        "unit": "Hz"
      },
      "s_complex": {
        "dtype": "complex128",
        "shape": "N",
        "unit": "dimensionless"
      }
    },
    "csv_columns": [
      "frequency_hz",
      "s_real",
      "s_imag"
    ],
    "acquisition_order": [
      "temperature",
      "resonator",
      "power"
    ]
  },
  "hardware_policy": {
    "default": "simulation",
    "lsci_reader_retains_control": true,
    "direct_lakeshore_factory_access": false,
    "physical_temperature_interface": "read-only text logs"
  },
  "commit_policy": {
    "commit_completed_changes": true,
    "push_when_authorized_and_available": true,
    "force_push": false
  },
  "license": "not selected"
}
